%                     if connect_Matrix(node1, node2) == 1
%                         % 绘制建筑 node1 和 node2 之间的连线，使用特定颜色
%                         plot([coords(node1,1) coords(node2,1)], [coords(node1,2) coords(node2,2)], '-', 'Color', colors(k,:), 'LineWidth', lineWidth);
%                     endcorresponding_cost
